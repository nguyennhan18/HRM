DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrm
DB_USERNAME=hrm
DB_PASSWORD=hrm_dev_password
# Required: generate a private random value of at least 32 bytes; never commit it.
HRM_JWT_SECRET=
# Employee identifiers: private random key of at least 32 bytes; no default.
# Keep stable and back it up securely: existing HMACs cannot be re-keyed without original input.
HRM_EMPLOYEE_HMAC_KEY=

# Private local storage (outside static/web directories); maximum 10 MiB
HRM_DOCUMENT_DIRECTORY=./data/documents
HRM_DOCUMENT_MAX_SIZE=10MB
